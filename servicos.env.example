# ==========================================================
# Arquivo de configuraÃ§Ã£o - Monitoramento VPS
# ==========================================================

# --- ServiÃ§os a monitorar (systemd) ---
# Formato: nome_amigavel:nome_do_servico_systemd
SERVICOS=(
  "SSH:ssh"
  "Docker:docker"
  "Fail2ban:fail2ban"
)

# --- Containers Docker a monitorar (bancos de dados) ---
# Formato: nome_amigavel:padrao_de_busca_no_nome_do_container
# O padrÃ£o Ã© usado com "grep" para localizar o container atual,
# mesmo que o hash/rÃ©plica mude apÃ³s reinÃ­cio ou redeploy.
CONTAINERS_DB=(
  "Supabase-Odonto-HML:agaeme_odonto_hml_supabase_agaeme_odonto_hml-db"
  "Supabase-Odonto:agaeme_odonto_supabase_agaeme_odonto_h-db"
  "Supabase-Textil:agaeme_textil_supabase-db"
)

# --- Container do proxy reverso (Traefik) a monitorar ---
# Formato: nome_amigavel:padrao_de_busca
CONTAINERS_PROXY=(
  "Traefik:easypanel-traefik"
)

# --- Nome do banco Postgres a verificar tamanho (padrÃ£o Supabase) ---
POSTGRES_DB_NOME="postgres"
POSTGRES_USER="postgres"

# --- Limite de tamanho de banco para alerta (em MB) ---
LIMITE_DB_TAMANHO_MB=5000

# --- Interface de rede a monitorar ---
# Deixe vazio para detectar automaticamente a interface padrÃ£o
INTERFACE_REDE=""

# --- Limites de alerta ---
LIMITE_RAM_PERCENT=85          # % de uso de RAM para alerta
LIMITE_SWAP_PERCENT=80         # % de uso de SWAP para alerta
LIMITE_DISCO_PERCENT=85        # % de uso de disco para alerta
LIMITE_CPU_PERCENT=90          # % de uso de CPU para alerta
LIMITE_CONEXOES_TCP=500        # NÃºmero de conexÃµes TCP simultÃ¢neas

# --- Discos/partiÃ§Ãµes a monitorar (separados por espaÃ§o) ---
PARTICOES_MONITORAR="/ /var /home"

# --- ConfiguraÃ§Ã£o de log ---
DIR_LOG="/Monitoramento/logs"
LOG_FILE="$DIR_LOG/monitor.log"
ERROR_LOG_FILE="$DIR_LOG/monitor_error.log"
RETENCAO_DIAS_LOG=5           # Dias para manter logs antigos (rotaÃ§Ã£o)

# --- DiretÃ³rio de execuÃ§Ã£o (lock) ---
DIR_RUN="/Monitoramento/run"
LOCK_FILE="$DIR_RUN/monitor.lock"

# --- Hostname customizado para identificaÃ§Ã£o nos logs (opcional) ---
HOSTNAME_CUSTOM=""

